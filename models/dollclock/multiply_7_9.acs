script 8 (void) {
  int moved = 0;
  int untagged = 0;
  for (int i = 0; i < 44; i++) {
    int tid = 0;
    if (i < 43) {
      tid = 10000 + i;
      if (!IsTIDUsed(tid)) { untagged++; continue; }
    }
    int x = GetActorX(tid);
    int y = GetActorY(tid);
    int z = GetActorZ(tid);
    if (x != mo_x[i] || y != mo_y[i] || z != mo_z[i]) { moved++; mo_x[i] = x; mo_y[i] = y; mo_z[i] = z; }
  }
  o1 = moved;
  o2 = untagged;
}
