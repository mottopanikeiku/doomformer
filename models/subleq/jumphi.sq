; jumphi.sq: the jump target of slot 2 is rewritten to 10 (hi digit 1), outside 0..5: the machine must halt.
; Written independently of the machine's code; checked against a separate 40-line interpreter and run in
; DOOM on both clocks (docs/machine.md).
s0:     subleq nine, s2.c, s1    ; s2.c = 1 - (-9) = 10 -> halt target through the high digit
s1:     subleq k, r, s2
s2:     subleq z, z, 1           ; c rewritten to 10 (hi = 1): must halt
s3:     subleq k, r, halt
.cell nine -9
.cell k 1
.cell z 0
.cell r 0
